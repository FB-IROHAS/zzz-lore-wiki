{
  "devDependencies": {
    "vitepress": "^1.6.4",
    "wrangler": "^4.36.0"
  },
  "scripts": {
    "docs:dev": "node scripts/generate-terminology-pages.mjs && vitepress dev docs",
    "docs:build": "node scripts/generate-terminology-pages.mjs && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "dev:cloudflare": "npm run docs:build && wrangler dev",
    "deploy:cloudflare": "npm run docs:build && wrangler deploy",
    "deploy": "npm run docs:build && wrangler deploy"
  }
}
